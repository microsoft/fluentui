{
  "$schema": "../reviewers.schema.json",
  "version": 1,
  "repo": "microsoft/fluentui-system-icons",
  "queues": ["microsoft/cxe-prg"],
  "team": { "org": "microsoft", "slug": "cxe-prg" },
  "settings": { "reviewers": 1, "areaMatch": "hard", "unknownMemberPolicy": "exclude-and-report" },
  "areas": {
    "react-icons": {
      "label": "React and SVG icon packages",
      "scopes": ["react-icons", "react-icons-file-type", "svg-icons", "svg-sprites"],
      "paths": [
        "packages/react-icons/**",
        "packages/react-icons-file-type/**",
        "packages/svg-icons/**",
        "packages/svg-sprites/**"
      ]
    },
    "build": {
      "label": "Build, CI and tooling",
      "scopes": ["tooling", "build", "ci", "eslint-plugin-react-icons", "webpack"],
      "paths": ["**"]
    },
    "docs": {
      "label": "Icon documentation and demos",
      "scopes": ["docsite", "docs", "icon-app"],
      "paths": ["packages/docsite/**", "packages/icon-app/**", "docs/**"]
    },
    "assets": { "label": "Icon assets", "scopes": ["icons", "assets"], "paths": ["assets/**"] },
    "platforms": {
      "label": "Native platform packages",
      "scopes": ["react-native", "android", "ios", "flutter"],
      "paths": ["android/**", "ios/**", "flutter/**", "packages/react-native-icons/**"]
    }
  },
  "reviewers": [
    {
      "login": "Hotell",
      "eligible": true,
      "fallbackEligible": false,
      "primary": ["react-icons", "build", "docs"],
      "secondary": []
    },
    { "login": "dmytrokirpa", "eligible": true, "primary": [], "secondary": ["react-icons", "build", "docs"] },
    { "login": "ValentinaKozlova", "eligible": false, "primary": [], "secondary": [] },
    { "login": "mainframev", "eligible": true, "primary": [], "secondary": ["react-icons", "build", "docs"] },
    { "login": "paolo-aliprandi", "eligible": false, "primary": [], "secondary": [] },
    { "login": "gouttierre", "eligible": false, "primary": [], "secondary": [] },
    { "login": "tudorpopams", "eligible": false, "primary": [], "secondary": [] },
    { "login": "PaulGMardling", "eligible": false, "primary": [], "secondary": [] }
  ]
}
