{
  "name": "react-compiler-analyzer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/react-compiler-analyzer/src",
  "projectType": "library",
  "tags": ["platform:node", "tools"],
  "targets": {
    "verify-installed": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node tests/verify-installed.mjs"
      }
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node tests/benchmark.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "node esbuild.config.mjs"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/tools/react-compiler-analyzer"],
      "options": {
        "jestConfig": "tools/react-compiler-analyzer/jest.config.ts"
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/react-compiler-analyzer-integration"],
      "options": {
        "jestConfig": "tools/react-compiler-analyzer/jest.integration.config.ts",
        "runInBand": true,
        "passWithNoTests": false
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc -p tsconfig.lib.json --noEmit", "tsc -p tsconfig.integration.json --noEmit"],
        "parallel": false
      }
    }
  }
}
