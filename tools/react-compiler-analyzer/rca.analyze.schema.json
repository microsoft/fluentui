{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/microsoft/fluentui/master/tools/react-compiler-analyzer/rca.analyze.schema.json",
  "title": "React Compiler Analyzer analyze output",
  "description": "SchemaVersion 3 analysis evidence emitted by analyze --format json. Statistics are not emitted-code evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "command",
    "mode",
    "profile",
    "emittedCaching",
    "summary",
    "functions",
    "findings",
    "unparseable"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "tool": {
      "const": "react-compiler-analyzer"
    },
    "command": {
      "const": "analyze"
    },
    "mode": {
      "enum": ["infer", "annotation", "all"]
    },
    "profile": { "$ref": "#/definitions/profile" },
    "emittedCaching": { "const": "unverified" },
    "summary": {
      "$ref": "#/definitions/summary"
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/function"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "unparseable": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/unparseable"
      }
    },
    "annotate": {
      "$ref": "#/definitions/annotate"
    }
  },
  "definitions": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "babelVersion",
        "compilerVersion",
        "mode",
        "parserPlugins",
        "noEmit",
        "panicThreshold",
        "target",
        "suppressionRules"
      ],
      "properties": {
        "backend": { "const": "babel" },
        "babelVersion": { "type": "string", "minLength": 1 },
        "compilerVersion": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["infer", "annotation", "all"] },
        "parserPlugins": { "type": "array", "items": { "type": "string" } },
        "noEmit": { "const": true },
        "panicThreshold": { "const": "none" },
        "target": { "const": "compiler-default" },
        "suppressionRules": { "const": "compiler-default" }
      }
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functions",
        "compiled",
        "reportedMemoCachePositive",
        "reportedMemoCacheZero",
        "reportedMemoCacheUnavailable",
        "suppressionRejected",
        "suppressionRejectedWithRisks",
        "skipped",
        "errors",
        "findings",
        "findingsOnCompiled",
        "findingsSuppressed",
        "unparseableFiles"
      ],
      "properties": {
        "functions": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "compiled": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "reportedMemoCachePositive": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "reportedMemoCacheZero": { "$ref": "#/definitions/nonNegativeInteger" },
        "reportedMemoCacheUnavailable": { "$ref": "#/definitions/nonNegativeInteger" },
        "suppressionRejected": { "$ref": "#/definitions/nonNegativeInteger" },
        "suppressionRejectedWithRisks": { "$ref": "#/definitions/nonNegativeInteger" },
        "skipped": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "errors": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "findings": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "findingsOnCompiled": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "findingsSuppressed": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "unparseableFiles": {
          "$ref": "#/definitions/nonNegativeInteger"
        }
      }
    },
    "memoStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoSlots", "memoBlocks", "memoValues", "prunedMemoBlocks", "prunedMemoValues"],
      "properties": {
        "memoSlots": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "memoBlocks": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "memoValues": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "prunedMemoBlocks": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "prunedMemoValues": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "manualMemo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useMemo", "useCallback", "reactMemo", "reactMemoHasComparator"],
      "properties": {
        "useMemo": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "useCallback": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "reactMemo": {
          "type": "boolean"
        },
        "reactMemoHasComparator": {
          "type": "boolean"
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "package", "line", "column", "function", "status", "compilerEvent"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "$ref": "#/definitions/nullableString"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "function": {
          "$ref": "#/definitions/nullableString"
        },
        "status": {
          "enum": ["compiled", "skipped", "error"]
        },
        "compilerEvent": {
          "enum": ["CompileSuccess", "CompileError", "CompileSkip", "PipelineError"]
        },
        "reason": {
          "type": "string"
        },
        "rejectionKind": { "const": "suppression-related" },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reason"],
            "properties": {
              "kind": { "enum": ["CompileError", "PipelineError"] },
              "reason": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        },
        "errorLine": {
          "type": "integer",
          "minimum": 1
        },
        "errorColumn": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "memoStats": {
          "anyOf": [
            {
              "$ref": "#/definitions/memoStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "manualMemo": {
          "$ref": "#/definitions/manualMemo"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "package",
        "line",
        "column",
        "function",
        "ruleId",
        "severity",
        "symbol",
        "message",
        "compiled"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "$ref": "#/definitions/nullableString"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "function": {
          "$ref": "#/definitions/nullableString"
        },
        "ruleId": {
          "enum": ["nonreactive-store-read", "hidden-selector-hook"]
        },
        "severity": {
          "enum": ["high", "medium"]
        },
        "symbol": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "compiled": {
          "type": "boolean"
        },
        "suppressed": {
          "const": true
        }
      }
    },
    "unparseable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "error"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "annotate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "filesModified", "functionsAnnotated", "functionsBailedOut"],
      "dependencies": {
        "dryRun": ["planned"],
        "planned": ["dryRun"]
      },
      "if": { "required": ["dryRun"] },
      "then": {
        "properties": {
          "filesModified": { "const": 0 },
          "functionsAnnotated": { "const": 0 },
          "functionsBailedOut": { "const": 0 }
        }
      },
      "properties": {
        "dryRun": { "const": true },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "line",
              "functionName",
              "directive",
              "rationale",
              "reportedMemoCache",
              "emittedCaching",
              "riskRules"
            ],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "functionName": { "$ref": "#/definitions/nullableString" },
              "directive": { "enum": ["use memo", "use no memo"] },
              "rationale": { "enum": ["preventive-risk-opt-out", "compiler-accepted-opt-in"] },
              "reportedMemoCache": { "enum": ["positive", "zero", "unavailable"] },
              "emittedCaching": { "const": "unverified" },
              "riskRules": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["nonreactive-store-read", "hidden-selector-hook"] }
              }
            }
          }
        },
        "planned": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesModified", "functionsAnnotated", "functionsBailedOut"],
          "properties": {
            "filesModified": { "$ref": "#/definitions/nonNegativeInteger" },
            "functionsAnnotated": { "$ref": "#/definitions/nonNegativeInteger" },
            "functionsBailedOut": { "$ref": "#/definitions/nonNegativeInteger" }
          }
        },
        "mode": {
          "enum": ["manual-memo", "all", "all-safe", "bailout-only"]
        },
        "filesModified": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "functionsAnnotated": {
          "$ref": "#/definitions/nonNegativeInteger"
        },
        "functionsBailedOut": {
          "$ref": "#/definitions/nonNegativeInteger"
        }
      }
    }
  }
}
