{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fluent UI declarative package extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "system", "skill"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "system": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "skill": {
      "$ref": "#/definitions/markdownPath",
      "description": "Package-relative entry guide. All relative Markdown references must be listed in references."
    },
    "references": {
      "type": "array",
      "maxItems": 31,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/markdownPath" }
    }
  },
  "definitions": {
    "markdownPath": {
      "type": "string",
      "pattern": "^\\./(?:[a-zA-Z0-9_-][a-zA-Z0-9._-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9._-]*\\.md$"
    }
  }
}
