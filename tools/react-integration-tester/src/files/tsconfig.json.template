{
  "extends": <%- JSON.stringify(`${relativePathToProjectRoot}/${tsconfig.pathToProjectConfig}`) %>,
  "compilerOptions": {
    "target": <%- JSON.stringify(tsconfig.target) %>,
    "module": "esnext",
    "moduleResolution": <%- JSON.stringify(tsconfig.moduleResolution) %>,
    "lib": <%- JSON.stringify(tsconfig.lib) %>,
    "strict": <%= tsconfig.strictMode %>,
    "pretty": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react",
    "skipLibCheck": true,
    "types": [],
    "typeRoots": <%- JSON.stringify([`${usedNodeModulesDirRelative}/node_modules/@types`]) %>,
    "baseUrl": ".",
    "paths": {
      "react/jsx-runtime": <%- JSON.stringify([`${usedNodeModulesDirRelative}/node_modules/@types/react/jsx-runtime.d.ts`]) %>,
      "react": <%- JSON.stringify([`${usedNodeModulesDirRelative}/node_modules/@types/react/index.d.ts`]) %>,
      "react-dom": <%- JSON.stringify([`${usedNodeModulesDirRelative}/node_modules/@types/react-dom/index.d.ts`]) %>
    }
  },
  "references": [],
  "exclude": <%- JSON.stringify(tsconfig.relativeExcludePaths) %>,
  "include": <%- JSON.stringify(tsconfig.relativeIncludePaths) %>,
  "files": <%- JSON.stringify(tsconfig.relativeFilesPaths) %>
}
