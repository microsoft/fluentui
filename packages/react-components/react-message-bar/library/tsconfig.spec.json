{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "dist",
    // "static-assets" declares `*.module.css` (typings/static-assets/index.d.ts) — the
    // spec program compiles the styles hooks transitively via the components under test.
    "types": ["jest", "node", "static-assets"]
  },
  "include": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.ts",
    "./src/testing/**/*.ts",
    "./src/testing/**/*.tsx"
  ]
}
