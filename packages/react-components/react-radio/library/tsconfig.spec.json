{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "dist",
    // "static-assets" declares `*.module.css` (typings/static-assets/index.d.ts) — required
    // since the package's conversion to CSS Modules (same setup as react-positioning).
    "types": ["jest", "node", "static-assets"]
  },
  "include": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.d.ts",
    "./src/testing/**/*.ts",
    "./src/testing/**/*.tsx"
  ]
}
