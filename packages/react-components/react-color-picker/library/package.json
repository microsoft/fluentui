{
  "name": "@fluentui/react-color-picker",
  "version": "9.3.1",
  "description": "ColorPicker component for Fluent UI React.",
  "main": "lib-commonjs/index.cjs",
  "module": "lib/index.js",
  "typings": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "*.md",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "lib",
    "lib-commonjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui"
  },
  "license": "MIT",
  "dependencies": {
    "@fluentui/react-context-selector": "^9.2.20",
    "@fluentui/react-jsx-runtime": "^9.4.6",
    "@fluentui/react-shared-contexts": "^9.26.4",
    "@fluentui/react-tabster": "^9.26.18",
    "@fluentui/react-theme": "^9.2.2",
    "@fluentui/react-utilities": "^9.26.7",
    "@griffel/react": "^1.5.32",
    "@swc/helpers": "^0.5.1"
  },
  "peerDependencies": {
    "@types/react": ">=16.14.0 <20.0.0",
    "react": ">=16.14.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./lib-commonjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "beachball": {
    "disallowedChangeTypes": [
      "major",
      "prerelease"
    ]
  },
  "type": "module"
}
