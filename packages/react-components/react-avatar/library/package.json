{
  "name": "@fluentui/react-avatar",
  "version": "9.11.5",
  "description": "React components for building Microsoft web experiences.",
  "main": "lib-commonjs/index.cjs",
  "module": "lib/index.js",
  "typings": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui"
  },
  "license": "MIT",
  "devDependencies": {
    "@fluentui/react-tailwind-theme": "workspace:*",
    "es6-weak-map": "^2.0.2"
  },
  "dependencies": {
    "@fluentui/react-badge": "^9.5.5",
    "@fluentui/react-context-selector": "^9.2.19",
    "@fluentui/react-icons": "^2.0.245",
    "@fluentui/react-jsx-runtime": "^9.4.5",
    "@fluentui/react-popover": "^9.14.6",
    "@fluentui/react-shared-contexts": "^9.26.3",
    "@fluentui/react-theme": "^9.2.2",
    "@fluentui/react-tooltip": "^9.10.5",
    "@fluentui/react-utilities": "^9.26.6",
    "@swc/helpers": "^0.5.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@types/react": ">=16.14.0 <20.0.0",
    "@types/react-dom": ">=16.9.0 <20.0.0",
    "react": ">=16.14.0 <20.0.0",
    "react-dom": ">=16.14.0 <20.0.0"
  },
  "beachball": {
    "disallowedChangeTypes": [
      "prerelease"
    ]
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./lib-commonjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "*.md",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "lib",
    "lib-commonjs",
    "dist/styles.css"
  ],
  "imports": {
    "#theme": "@fluentui/react-tailwind-theme/css/index.css"
  },
  "type": "module"
}
