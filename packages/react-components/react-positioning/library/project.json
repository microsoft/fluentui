{
  "name": "react-positioning",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/react-components/react-positioning/library/src",
  "targets": {
    "test-webkit": {
      "cache": false,
      "command": "node --test packages/react-components/react-positioning/library/scripts/positioning-webkit.mjs"
    },
    "test-raster": {
      "cache": false,
      "dependsOn": ["build", { "target": "build", "projects": "scripts-cypress" }],
      "options": {
        "cwd": "packages/react-components/react-positioning/library",
        "command": "node scripts/positioning-raster.mjs"
      },
      "executor": "nx:run-commands"
    },
    "benchmark": {
      "cache": false,
      "dependsOn": ["build", { "target": "build", "projects": "scripts-cypress" }],
      "options": {
        "cwd": "packages/react-components/react-positioning/library",
        "command": "node scripts/positioning-benchmark.mjs"
      },
      "executor": "nx:run-commands"
    },
    "e2e": {
      "inputs": ["default", "^production", "{projectRoot}/cypress.config.ts"]
    }
  },
  "tags": ["vNext", "platform:web"],
  "implicitDependencies": []
}
