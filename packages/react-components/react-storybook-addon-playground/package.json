{
  "name": "@fluentui/react-storybook-addon-playground",
  "version": "0.0.1",
  "description": "Storybook addon that ships an in-browser TSX playground for Fluent UI React v9 stories",
  "main": "lib-commonjs/index.js",
  "module": "lib/index.js",
  "typings": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui"
  },
  "license": "MIT",
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.245",
    "@fluentui/react-utilities": "^9.26.7",
    "@swc/helpers": "^0.5.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.33.0",
    "postcss": "8.5.18",
    "prettier": "^2.8.8",
    "semver": "^6.2.0"
  },
  "peerDependencies": {
    "@storybook/react": ">=9.1.17",
    "@types/react": ">=16.14.0 <20.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "beachball": {
    "disallowedChangeTypes": [
      "major",
      "prerelease"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "module": "./lib/index.js",
        "default": "./lib-commonjs/index.js"
      },
      "import": "./lib/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "node": {
        "module": "./lib/setup.js",
        "default": "./lib-commonjs/setup.js"
      },
      "import": "./lib/setup.js",
      "require": "./lib-commonjs/setup.js"
    },
    "./preset": "./preset.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/styles.css",
    "./src/playground/monaco.ts"
  ],
  "files": [
    "*.md",
    "dist/*.d.ts",
    "dist/styles.css",
    "dist/playground",
    "lib",
    "lib-commonjs",
    "preset.js",
    "tools"
  ]
}
