{
  "name": "react-tag-picker",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/react-components/react-tag-picker/library/src",
  "tags": ["platform:web", "vNext"],
  "implicitDependencies": [],
  "metadata": {
    "apiMetadata": {
      "system": "fluent-v9"
    }
  },
  "targets": {
    "build": {
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/api-extractor/api-extractor.*.json",
        "apiMetadataGenerator"
      ],
      "dependsOn": [
        "^build",
        {
          "projects": ["api-metadata"],
          "target": "build"
        }
      ]
    },
    "generate-api": {
      "dependsOn": [
        "^generate-api",
        {
          "projects": ["api-metadata"],
          "target": "build"
        }
      ]
    }
  }
}
