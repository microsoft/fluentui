{
  "name": "@fluentui/react-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Prebuilt in-browser React playground shell",
  "main": "lib-commonjs/index.js",
  "module": "lib/index.js",
  "typings": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/fluentui"
  },
  "license": "MIT",
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.245",
    "@fluentui/react-shared-contexts": "^9.26.3",
    "@fluentui/react-utilities": "^9.26.6",
    "@swc/helpers": "^0.5.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "0.33.0",
    "prettier": "^2.8.8"
  },
  "peerDependencies": {
    "@types/react": ">=16.14.0 <20.0.0",
    "react": ">=16.14.0 <20.0.0",
    "react-dom": ">=16.14.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "module": "./lib/index.js",
        "default": "./lib-commonjs/index.js"
      },
      "import": "./lib/index.js",
      "require": "./lib-commonjs/index.js"
    },
    "./setup": {
      "types": "./dist/index.d.ts",
      "node": {
        "module": "./lib/setup.js",
        "default": "./lib-commonjs/setup.js"
      },
      "import": "./lib/setup.js",
      "require": "./lib-commonjs/setup.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/playground/monaco.ts"
  ],
  "files": [
    "*.md",
    "dist/*.d.ts",
    "dist/playground",
    "lib",
    "lib-commonjs"
  ]
}
