{
  "name": "react-playground",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "implicitDependencies": [],
  "sourceRoot": "packages/react-components/react-playground/src",
  "tags": ["vNext", "platform:any", "tools"],
  "targets": {
    "build": {
      "dependsOn": ["^build", "build-app"]
    },
    "build-app": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist/playground"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "webpack --config webpack.config.js"
      }
    }
  }
}
