{
  "name": "react-headless-components-preview",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/react-components/react-headless-components-preview/library/src",
  "tags": ["vNext", "platform:web", "react-headless"],
  "implicitDependencies": [],
  "targets": {
    "generate-api": {
      "options": {
        "exportSubpaths": true
      }
    },
    "verify-bundle-isolation": {
      "cache": true,
      "dependsOn": ["build", "^build"],
      "command": "yarn run -T verify-bundle-isolation",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["default", "^default", { "externalDependencies": ["ajv", "webpack"] }],
      "outputs": ["{projectRoot}/dist/bundle-isolation"],
      "metadata": {
        "technologies": ["webpack"],
        "description": "Assert entry points do not bundle tabster, Griffel or react-icons"
      }
    }
  }
}
