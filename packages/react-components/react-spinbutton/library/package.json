{
  "name": "@fluentui/react-spinbutton",
  "version": "9.6.4",
  "description": "Fluent UI React SpinButton component.",
  "main": "lib-commonjs/index.js",
  "module": "lib/index.js",
  "typings": "./dist/index.d.ts",
