{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "dist",
    // "static-assets" declares `*.module.css` (typings/static-assets/index.d.ts) — the
    // spec program compiles the styles files transitively via the components under test,
    // and the converted tests import the modules directly to assert class application.
    "types": ["jest", "node", "static-assets"]
  },
  "include": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.test.ts", "**/*.test.tsx", "**/*.d.ts"]
}
