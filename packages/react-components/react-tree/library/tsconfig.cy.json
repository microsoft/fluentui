{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": false,
    // "static-assets" declares `*.module.css` (typings/static-assets/index.d.ts); the cy program
    // reaches the converted styles hooks transitively. This tsconfig replaces the base `typeRoots`
    // (which includes `./typings`), so the repo's typings directory is re-listed here to resolve it.
    "types": ["node", "cypress", "cypress-real-events", "static-assets"],
    "typeRoots": ["../../../../node_modules", "../../../../node_modules/@types", "../../../../typings"]
  },
  "include": ["**/*.cy.ts", "**/*.cy.tsx"]
}
