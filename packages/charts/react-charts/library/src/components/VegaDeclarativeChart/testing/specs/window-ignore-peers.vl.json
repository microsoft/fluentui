{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A trailing two-row frame ignores peers; rank and lag ignore the frame.",
  "width": 640,
  "height": 400,
  "data": {
    "values": [
      { "id": 1, "key": 1, "amount": 2, "cost": 10 },
      { "id": 2, "key": 1, "amount": 4, "cost": 20 },
      { "id": 3, "key": 2, "amount": 8, "cost": 30 },
      { "id": 4, "key": 3, "amount": 16, "cost": 40 }
    ]
  },
  "transform": [
    {
      "window": [
        { "op": "sum", "field": "amount", "as": "amount_sum" },
        { "op": "sum", "field": "cost", "as": "cost_sum" },
        { "op": "rank", "as": "rank" },
        { "op": "lag", "field": "amount", "param": 1, "as": "previous" },
        { "op": "first_value", "field": "amount", "as": "first" }
      ],
      "sort": [{ "field": "key", "order": "ascending" }],
      "frame": [-1, 0],
      "ignorePeers": true
    }
  ],
  "mark": "line",
  "encoding": {
    "x": { "field": "id", "type": "quantitative" },
    "y": { "field": "amount_sum", "type": "quantitative" }
  }
}
