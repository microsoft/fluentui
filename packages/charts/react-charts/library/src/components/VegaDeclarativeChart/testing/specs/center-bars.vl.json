{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Center bars use absolute contributions and the maximum group total, not a zero or silhouette baseline.",
  "width": 272,
  "height": 172,
  "data": {
    "values": [
      { "category": "A", "series": "First", "amount": 2, "priority": 0 },
      { "category": "A", "series": "Second", "amount": 6, "priority": 1 },
      { "category": "B", "series": "First", "amount": -2, "priority": 0 },
      { "category": "B", "series": "Second", "amount": 2, "priority": 1 }
    ]
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "category",
      "type": "nominal",
      "scale": { "domain": ["A", "B"], "paddingInner": 0, "paddingOuter": 0 }
    },
    "y": { "field": "amount", "type": "quantitative", "stack": "center", "scale": { "domain": [0, 8] } },
    "order": { "field": "priority", "type": "quantitative", "sort": "ascending" },
    "color": { "field": "series", "type": "nominal", "scale": { "domain": ["First", "Second"] } },
    "tooltip": [
      { "field": "series", "type": "nominal", "title": "Series" },
      { "field": "amount", "type": "quantitative", "title": "Raw amount" }
    ]
  }
}
