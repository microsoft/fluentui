    "clsx": "^2.1.1",
    "d3-array": "^3.0.0",
    "d3-axis": "^3.0.0",
    "d3-color": "^3.0.0",
    "d3-format": "^3.0.0",
    "d3-hierarchy": "^3.0.0",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.0",
