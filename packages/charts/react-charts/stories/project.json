{
  "name": "react-charts-stories",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/react-charts/stories/src",
  "tags": ["vNext", "platform:web", "type:stories", "charting"],
  "implicitDependencies": [],
  "targets": {
    "test-browser:vega": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "node scripts/verify-vega-stories.cjs"
      }
    },
    "test-ssr": {
      "options": {
        "cwd": "{projectRoot}",
        "command": "yarn run -T test-ssr \"./src/**/*.stories.ssr.tsx\""
      }
    }
  }
}
