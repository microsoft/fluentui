{
  "name": "public-docsite-v9-new",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/public-docsite-v9-new/app",
  "tags": ["platform:web", "vNext"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build"
      },
      "outputs": ["{projectRoot}/dist"],
      "inputs": [
        "default",
        "{projectRoot}/content/**",
        "{projectRoot}/vite.config.ts",
        "{projectRoot}/react-router.config.ts",
        "{projectRoot}/source.config.ts"
      ],
      "dependsOn": [
        "docgen",
        {
          "projects": ["babel-preset-storybook-full-source", "react-storybook-addon-export-to-sandbox"],
          "target": "build"
        }
      ]
    },
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev"
      }
    },
    "type-check": {
      "executor": "nx:run-script",
      "options": {
        "script": "type-check"
      }
    },
    "lint": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      }
    },
    "docgen": {
      "executor": "nx:run-script",
      "options": {
        "script": "docgen"
      },
      "outputs": ["{projectRoot}/app/generated"],
      "inputs": [
        "{projectRoot}/scripts/**",
        "{workspaceRoot}/tsconfig.base.all.json",
        {
          "dependentTasksOutputFiles": "**/*.d.ts"
        }
      ],
      "dependsOn": [
        {
          "projects": ["babel-preset-storybook-full-source"],
          "target": "build"
        }
      ]
    },
    "test-a11y": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:a11y"
      },
      "dependsOn": ["build"]
    },
    "test-content": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:content"
      },
      "dependsOn": ["build"]
    },
    "test-links": {
      "executor": "nx:run-script",
      "options": {
        "script": "test:links"
      },
      "dependsOn": ["build"]
    }
  },
  "implicitDependencies": ["tag:type:stories"]
}
