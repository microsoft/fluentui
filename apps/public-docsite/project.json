{
  "name": "public-docsite",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [],
  "tags": ["v8"],
  "targets": {
    "e2e": {
      "dependsOn": ["bundle", "type-check"],
      "inputs": ["default", "^production", { "externalDependencies": ["@playwright/test"] }],
      "outputs": ["{projectRoot}/test-results"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "format": {},
    "type-check": {
      "dependsOn": ["prebundle"]
    },
    "prebundle": {
      "dependsOn": ["^build"]
    },
    "bundle": {
      "dependsOn": ["prebundle"],
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
