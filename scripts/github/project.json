{
  "name": "scripts-github",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "scripts/github/src",
  "projectType": "library",
  "targets": {
    "risk-eval-label": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/github/src/risk-eval-label.js"
      }
    },
    "risk-eval-score": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/github/src/risk-eval-score.js"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/.github/workflows/create-experimental-branch.yml",
        "{workspaceRoot}/.github/risk-tiers.json",
        "{workspaceRoot}/.github/workflows/pr-housekeeping.yml",
        { "env": "FLUENT_RISK_LIVE_TEST" }
      ]
    }
  },
  "tags": ["tools"]
}
